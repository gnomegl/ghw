# This block was generated by argc (https://github.com/sigoden/argc).
# Modifying it manually is not recommended

_argc_run() {
    if [[ "${1:-}" == "___internal___" ]]; then
        _argc_die "error: unsupported ___internal___ command"
    fi
    if [[ "${OS:-}" == "Windows_NT" ]] && [[ -n "${MSYSTEM:-}" ]]; then
        set -o igncr
    fi
    argc__args=("$(basename "$0" .sh)" "$@")
    argc__positionals=()
    _argc_index=1
    _argc_len="${#argc__args[@]}"
    _argc_tools=()
    _argc_parse
    if [ -n "${argc__fn:-}" ]; then
        $argc__fn "${argc__positionals[@]}"
    fi
}

_argc_usage() {
    cat <<-'EOF'
Gray Hat Warfare API client for searching exposed cloud storage

USAGE: ghw [OPTIONS] <COMMAND>

OPTIONS:
  -j, --json     Output raw JSON instead of formatted results
  -q, --quiet    Suppress colored output and progress
  -h, --help     Print help
  -V, --version  Print version

COMMANDS:
  search   Search for files in exposed buckets
  buckets  List exposed buckets
  bucket   Get bucket details and file listing
  files    List all files in a specific bucket

ENVIRONMENTS:
  GRAYHAT_API_KEY*  Gray Hat Warfare API key
EOF
    exit
}

_argc_version() {
    echo ghw 0.0.0
    exit
}

_argc_parse() {
    local _argc_key _argc_action
    local _argc_subcmds="search, buckets, bucket, files"
    while [[ $_argc_index -lt $_argc_len ]]; do
        _argc_item="${argc__args[_argc_index]}"
        _argc_key="${_argc_item%%=*}"
        case "$_argc_key" in
        --help | -help | -h)
            _argc_usage
            ;;
        --version | -version | -V)
            _argc_version
            ;;
        --)
            _argc_dash="${#argc__positionals[@]}"
            argc__positionals+=("${argc__args[@]:$((_argc_index + 1))}")
            _argc_index=$_argc_len
            break
            ;;
        --json | -j)
            if [[ "$_argc_item" == *=* ]]; then
                _argc_die "error: flag \`--json\` don't accept any value"
            fi
            _argc_index=$((_argc_index + 1))
            if [[ -n "${argc_json:-}" ]]; then
                _argc_die "error: the argument \`--json\` cannot be used multiple times"
            else
                argc_json=1
            fi
            ;;
        --quiet | -q)
            if [[ "$_argc_item" == *=* ]]; then
                _argc_die "error: flag \`--quiet\` don't accept any value"
            fi
            _argc_index=$((_argc_index + 1))
            if [[ -n "${argc_quiet:-}" ]]; then
                _argc_die "error: the argument \`--quiet\` cannot be used multiple times"
            else
                argc_quiet=1
            fi
            ;;
        search)
            _argc_index=$((_argc_index + 1))
            _argc_action=_argc_parse_search
            break
            ;;
        buckets)
            _argc_index=$((_argc_index + 1))
            _argc_action=_argc_parse_buckets
            break
            ;;
        bucket)
            _argc_index=$((_argc_index + 1))
            _argc_action=_argc_parse_bucket
            break
            ;;
        files)
            _argc_index=$((_argc_index + 1))
            _argc_action=_argc_parse_files
            break
            ;;
        help)
            local help_arg="${argc__args[$((_argc_index + 1))]:-}"
            case "$help_arg" in
            search)
                _argc_usage_search
                ;;
            buckets)
                _argc_usage_buckets
                ;;
            bucket)
                _argc_usage_bucket
                ;;
            files)
                _argc_usage_files
                ;;
            "")
                _argc_usage
                ;;
            *)
                _argc_die "error: invalid value \`$help_arg\` for \`<command>\`"$'\n'"  [possible values: $_argc_subcmds]"
                ;;
            esac
            ;;
        *)
            if _argc_maybe_flag_option "-" "$_argc_item"; then
                _argc_die "error: unexpected argument \`$_argc_key\` found"
            fi
            _argc_die "error: \`ghw\` requires a subcommand but one was not provided"$'\n'"  [subcommands: $_argc_subcmds]"
            ;;
        esac
    done
    if [[ -n "${_argc_action:-}" ]]; then
        $_argc_action
    else
        _argc_usage
    fi
}

