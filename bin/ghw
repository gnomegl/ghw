                _argc_die "error: the argument \`--start\` cannot be used multiple times"
            fi
            ;;
        --limit | -l)
            _argc_take_args "--limit <NUM>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_limit:-}" ]]; then
                argc_limit="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--limit\` cannot be used multiple times"
            fi
            ;;
        --size-from)
            _argc_take_args "--size-from <BYTES>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_size_from:-}" ]]; then
                argc_size_from="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--size-from\` cannot be used multiple times"
            fi
            ;;
        --size-to)
            _argc_take_args "--size-to <BYTES>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_size_to:-}" ]]; then
                argc_size_to="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--size-to\` cannot be used multiple times"
            fi
            ;;
        --full-path)
            if [[ "$_argc_item" == *=* ]]; then
                _argc_die "error: flag \`--full-path\` don't accept any value"
            fi
            _argc_index=$((_argc_index + 1))
            if [[ -n "${argc_full_path:-}" ]]; then
                _argc_die "error: the argument \`--full-path\` cannot be used multiple times"
            else
                argc_full_path=1
            fi
            ;;
        --regexp)
            if [[ "$_argc_item" == *=* ]]; then
                _argc_die "error: flag \`--regexp\` don't accept any value"
            fi
            _argc_index=$((_argc_index + 1))
            if [[ -n "${argc_regexp:-}" ]]; then
                _argc_die "error: the argument \`--regexp\` cannot be used multiple times"
            else
                argc_regexp=1
            fi
            ;;
        *)
            if _argc_maybe_flag_option "-" "$_argc_item"; then
                _argc_die "error: unexpected argument \`$_argc_key\` found"
            fi
            argc__positionals+=("$_argc_item")
            _argc_index=$((_argc_index + 1))
            ;;
        esac
    done
    if [[ -n "${_argc_action:-}" ]]; then
        $_argc_action
    else
        argc__fn=search
        if [[ "${argc__positionals[0]:-}" == "help" ]] && [[ "${#argc__positionals[@]}" -eq 1 ]]; then
            _argc_usage_search
        fi
        _argc_match_positionals 0
        local values_index values_size
        IFS=: read -r values_index values_size <<<"${_argc_match_positionals_values[0]:-}"
        if [[ -n "$values_index" ]]; then
            argc_keywords="${argc__positionals[values_index]}"
        else
            _argc_die "error: the required environments \`<KEYWORDS>\` were not provided"
        fi
        _argc_require_params "error: the following required environments were not provided:" \
