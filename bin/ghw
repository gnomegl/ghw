Search for files in exposed buckets

USAGE: ghw search [OPTIONS] <KEYWORDS>

ARGS:
  <KEYWORDS>  Search keywords (space separated)

OPTIONS:
  -e, --extensions <EXT>          File extensions to search for (comma separated)
  -b, --buckets <BUCKET>          Specific buckets to search (comma separated)
      --exclude-buckets <BUCKET>  Buckets to exclude (comma separated)
  -s, --start <NUM>               Starting offset (default: 0)
  -l, --limit <NUM>               Number of results to return (default: 10, max: 1000)
      --size-from <BYTES>         Minimum file size in bytes
      --size-to <BYTES>           Maximum file size in bytes
      --full-path                 Search in full file path instead of just filename
      --regexp                    Use regular expressions in keywords
  -h, --help                      Print help

ENVIRONMENTS:
  GRAYHAT_API_KEY*  Gray Hat Warfare API key
EOF
    exit
}

_argc_parse_search() {
    local _argc_key _argc_action
    local _argc_subcmds=""
    while [[ $_argc_index -lt $_argc_len ]]; do
        _argc_item="${argc__args[_argc_index]}"
        _argc_key="${_argc_item%%=*}"
        case "$_argc_key" in
        --help | -help | -h)
            _argc_usage_search
            ;;
        --)
            _argc_dash="${#argc__positionals[@]}"
            argc__positionals+=("${argc__args[@]:$((_argc_index + 1))}")
            _argc_index=$_argc_len
            break
            ;;
        --extensions | -e)
            _argc_take_args "--extensions <EXT>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_extensions:-}" ]]; then
                argc_extensions="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--extensions\` cannot be used multiple times"
            fi
            ;;
        --buckets | -b)
