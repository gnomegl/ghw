            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_buckets:-}" ]]; then
                argc_buckets="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--buckets\` cannot be used multiple times"
            fi
            ;;
        --exclude-buckets)
            _argc_take_args "--exclude-buckets <BUCKET>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_exclude_buckets:-}" ]]; then
                argc_exclude_buckets="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--exclude-buckets\` cannot be used multiple times"
            fi
            ;;
        --start | -s)
            _argc_take_args "--start <NUM>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_start:-}" ]]; then
                argc_start="${_argc_take_args_values[0]:-}"
